# Common code for basic File Substitutions

SED := sed

# On entry, $(SUBS) should be either unset, empty or a list of leafnames of
# files within $(SUBDIR) which need to have substitutions made to them.
#
# If $(APP) is set to the name of an application directory, then the substituted
# files will be saved into $(OUTDIR)/$(APP)/, otherwise they will be saved
# directly into $(OUTDIR).
#
# $(VERSION) should contain the user-facing version number associated with the
# build.
#
# In the calling Makefile, $(SUBS) should be a prerequisite for the application
# target, while clean-subs should be a prerequisite for the clean target.
#
# $(SED) and $(RM) should point to their respective utilities.

# Make sure the variables that we need exist.

SUBS ?=
SUBDIR ?= subs

ifeq ($(OUTDIR),)
$(error Substitutions require OUTDIR to be set)
endif

ifeq ($(VERSION),)
$(error Substitutions require a VERSION to be set)
endif

ifeq ($(SED),)
$(error Substitutions require SED to be available)
endif

ifeq ($(RM),)
$(error Substitutions require RM to be available)
endif

# Prefix all of the leafnames in $(SUBS) with the target folder: either
# $(APP)/$(OUTDIR) or just $(OUTDIR)/ if $(APP) is unset.

ifneq ($(SUBS),)
SUBS := $(addprefix $(OUTDIR)/$(if $(APP),$(APP)/), $(SUBS))
endif

# The rule to process any changed target substitution files, looking at the
# corresponding filenames from within $(SUBDIR).
#
# For any files which need updating, we call Sed to look for the string
# "{{VERSION}}" within the text and replace it with the contents of $(VERSION).
#
# $(SUBS) should be a prerequisite of the application target.

ifneq ($(SUBS),)
$(SUBS): $(OUTDIR)/$(if $(APP),$(APP)/)%: $(SUBDIR)/% | $(OUTDIR)$(if $(APP),/$(APP))
	@$(call show-stage,SUBSTITUTING,$@)
	@$(SED) 's/{{VERSION}}/$(VERSION)/' $(SUBDIR)/$(@F) > $@
endif

# The rule to clean the substituted files.
#
# clean-subs should be a prerequisite of the clean target.

.PHONY: clean-subs

clean-subs:
ifneq ($(SUBS),)
	@$(call show-stage, CLEANING, $(SUBS))
	$(foreach SUBTARGET,$(SUBS),$(RM) $(SUBTARGET))
endif
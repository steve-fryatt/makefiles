# Common Rules for C Projects

SRCDIR ?= src
OBJDIR ?= obj

OBJS ?= main.o

INCLUDES ?=

BUILDINFO ?=

ifeq ($(CCFLAGS),)
$(error C Projects require CCFLAGS to be set)
endif

ifeq ($(VERSION),)
$(error C Projects require a VERSION to be set)
endif

ifeq ($(BUILD_DATE),)
$(error C Projects require a BUILD_DATE to be set)
endif

ifeq ($(RM),)
$(error C Projects require RM to be available)
endif

OBJS := $(addprefix $(OBJDIR)/, $(OBJS))

# Build the object files, and identify their dependencies.

-include $(OBJS:.o=.d)

$(OBJDIR)/%.o: $(SRCDIR)/%.c $(EXTRASRCPREREQ) | $(OBJDIR)
	@$(call show-stage,COMPILING,$<)
	@$(CC) -c $(CCFLAGS) -D'BUILD_VERSION="$(VERSION)"' -D'BUILD_DATE="$(BUILD_DATE)"' -D'BUILD_INFO="$(BUILDINFO)"' $(INCLUDES) $< -o $@
	@$(CC) -MM $(CCFLAGS) -D'BUILD_VERSION="$(VERSION)"' -D'BUILD_DATE="$(BUILD_DATE)"' -D'BUILD_INFO="$(BUILDINFO)"' $(INCLUDES) $< > $(@:.o=.d)
	@mv -f $(@:.o=.d) $(@:.o=.d).tmp
	@sed -e 's|.*:|$@:|' < $(@:.o=.d).tmp > $(@:.o=.d)
	@sed -e 's/.*://' -e 's/\\$$//' < $(@:.o=.d).tmp | fmt -1 | sed -e 's/^ *//' -e 's/$$/:/' >> $(@:.o=.d)
	@rm -f $(@:.o=.d).tmp

# The rule to clean the generated object and dependency files.
#
# clean-objects should be a prerequisite of the clean target.

.PHONY: clean-objects

clean-objects:
ifneq ($(OBJDIR),)
	@$(call show-stage, CLEANING, $(OBJDIR)/*)
	$(RM) $(OBJDIR)/*
endif

# Common Rules for C Projects

SRCDIR ?= src

OBJS ?= main.o

INCLUDES ?=

BUILDINFO ?=

# An optional list of subfolders that our client requires in the folders
# within $(OBJDIR)
OBJS_SUBDIRS ?=

ifeq ($(CCFLAGS),)
$(error C Projects require CCFLAGS to be set)
endif

ifeq ($(VERSION),)
$(error C Projects require a VERSION to be set)
endif

ifeq ($(BUILD_DATE),)
$(error C Projects require a BUILD_DATE to be set)
endif

ifeq ($(RM),)
$(error C Projects require RM to be available)
endif

# Definitions for the Unit Test build

# The folder holding the test files.
TESTDIR ?= test

# The folder holding the test source files.
TEST_SRCDIR ?= tests

# The folder holding the test output absolute files.
TEST_ABSDIR ?= absolute

# The folder holding Unity.
TEST_UNITYDIR ?= unity

# The Unity object and internals header files.
TEST_UNITYOBJ := unity.o
TEST_UNITYINT := unity_internals.h

# The prefix on all test source files.
TEST_PREFIX := test_

# The suffix on all test absolute files.
TEST_ABSSUFFIX := ,ff8

# The macros defined for all unit test builds.
TEST_DEFINES = -DUNIT_TESTING -D'BUILD_VERSION="$(VERSION)"' -D'BUILD_DATE="$(BUILD_DATE)"' -D'BUILD_INFO="$(BUILDINFO)"'

# The include folders for all unit test builds.
TEST_INCLUDES = -iquote$(TESTDIR)/$(TEST_UNITYDIR) -iquote$(SRCDIR) $(INCLUDES)

# Specific CC flags for all unit test target files (ie. application sources).
TEST_CCFLAGS = -Wno-unused-function

# Find the test_*.c source files.

TEST_SRCS = $(wildcard $(TESTDIR)/$(TEST_SRCDIR)/*.c)
TEST_ABSS = $(patsubst $(TESTDIR)/$(TEST_SRCDIR)/$(TEST_PREFIX)%.c, $(TESTDIR)/$(TEST_ABSDIR)/$(TEST_PREFIX)%$(TEST_ABSSUFFIX), $(TEST_SRCS))

# Create the subfolders within $(OBJDIR) for the test object files
# and dependency files.

TEST_OBJDIR := testo
TEST_DEPDIR := testd

$(OBJDIR)/$(TEST_OBJDIR): | $(OBJDIR)
	@$(call show-stage,CREATING,$(OBJDIR)/$(TEST_OBJDIR))
	@$(MKDIR) $(OBJDIR)/$(TEST_OBJDIR)

$(OBJDIR)/$(TEST_DEPDIR): | $(OBJDIR)
	@$(call show-stage,CREATING,$(OBJDIR)/$(TEST_DEPDIR))
	@$(MKDIR) $(OBJDIR)/$(TEST_DEPDIR)

# Identify the dependency and object files from the $(OBJS) list.

TEST_DEPS := $(addprefix $(OBJDIR)/$(TEST_DEPDIR)/, $(OBJS:.o=.d))
TEST_OBJS := $(addprefix $(OBJDIR)/$(TEST_OBJDIR)/, $(OBJS))

# The test targets.

.PHONY: test
test: $(TEST_ABSS) | $(OBJDIR)/$(TEST_OBJDIR) $(OBJDIR)/$(TEST_DEPDIR)

# Files from the test build process that we don't want to lose when the build is complete.

.PRECIOUS: $(TEST_ABSS) $(OBJDIR)/$(TEST_OBJDIR)/$(TEST_PREFIX)%.o $(OBJDIR)/$(TEST_OBJDIR)/%.o $(OBJDIR)/$(TEST_DEPDIR)/%.d

# Link the test absolute files.

$(TESTDIR)/$(TEST_ABSDIR)/$(TEST_PREFIX)%$(TEST_ABSSUFFIX): $(OBJDIR)/$(TEST_OBJDIR)/$(TEST_PREFIX)%.o $(OBJDIR)/$(TEST_OBJDIR)/$(TEST_UNITYOBJ) $(TEST_OBJS) | $(TESTDIR)/$(TEST_ABSDIR)
	@$(call show-stage,LINKING,$@)
	@$(CC) $(CCFLAGS) $(LINKS) -o $@ $^

# Include the test dependencies

-include $(TEST_DEPS)

# Make up any additional object subfolder prerequisite lists.

OBJS_TEST_SUBDEPDIRS = $(addprefix $(OBJDIR)/$(TEST_DEPDIR)/, $(OBJS_SUBDIRS))
OBJS_TEST_SUBOBJDIRS = $(addprefix $(OBJDIR)/$(TEST_OBJDIR)/, $(OBJS_SUBDIRS))

ifneq ($(OBJS_TEST_SUBDEPDIRS),)
$(OBJS_TEST_SUBDEPDIRS): %: | $(@D)
	@$(call show-stage,CREATING,$@)
	@$(MKDIR) $@
endif

ifneq ($(OBJS_TEST_SUBOBJDIRS),)
$(OBJS_TEST_SUBOBJDIRS): %: | $(@D)
	@$(call show-stage,CREATING,$@)
	@$(MKDIR) $@
endif

# Make the test harness object files.

$(OBJDIR)/$(TEST_OBJDIR)/$(TEST_PREFIX)%.o: $(TESTDIR)/$(TEST_SRCDIR)/$(TEST_PREFIX)%.c | $(OBJDIR)/$(TEST_OBJDIR) $(OBJDIR)/$(TEST_DEPDIR) $(OBJS_TEST_SUBOBJDIRS) $(OBJS_TEST_SUBDEPDIRS)
	@$(call show-stage,COMPILING,$<)
	@$(CC) -c $(CCFLAGS) $(TEST_INCLUDES) $(TEST_DEFINES) $< -o $@
	@$(CC) -MM $(CCFLAGS) -D'BUILD_VERSION="$(VERSION)"' -D'BUILD_DATE="$(BUILD_DATE)"' -D'BUILD_INFO="$(BUILDINFO)"' $(TEST_INCLUDES) $< > $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d)
	@mv -f $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d) $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d).tmp
	@sed -e 's|.*:|$@:|' < $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d).tmp > $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d)
	@sed -e 's/.*://' -e 's/\\$$//' < $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d).tmp | fmt -1 | sed -e 's/^ *//' -e 's/$$/:/' >> $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d)
	@rm -f $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d).tmp

# Make the test target object files.

$(OBJDIR)/$(TEST_OBJDIR)/%.o: $(SRCDIR)/%.c $(EXTRASRCPREREQ) | $(OBJDIR)/$(TEST_OBJDIR) $(OBJDIR)/$(TEST_DEPDIR) $(OBJS_TEST_SUBOBJDIRS) $(OBJS_TEST_SUBDEPDIRS)
	@$(call show-stage,COMPILING,$<)
	@$(CC) -c $(CCFLAGS) $(TEST_CCFLAGS) $(TEST_INCLUDES) $(TEST_DEFINES) $< -o $@
	@$(CC) -MM $(CCFLAGS) -D'BUILD_VERSION="$(VERSION)"' -D'BUILD_DATE="$(BUILD_DATE)"' -D'BUILD_INFO="$(BUILDINFO)"' $(TEST_INCLUDES) $< > $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d)
	@mv -f $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d) $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d).tmp
	@sed -e 's|.*:|$@:|' < $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d).tmp > $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d)
	@sed -e 's/.*://' -e 's/\\$$//' < $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d).tmp | fmt -1 | sed -e 's/^ *//' -e 's/$$/:/' >> $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d)
	@rm -f $(OBJDIR)/$(TEST_DEPDIR)/$(@F:.o=.d).tmp

# Make the Unity object files.

$(OBJDIR)/$(TEST_OBJDIR)/$(TEST_UNITYOBJ): $(TESTDIR)/$(TEST_UNITYDIR)/$(TEST_UNITYOBJ:.o=.c) $(TESTDIR)/$(TEST_UNITYDIR)/$(TEST_UNITYOBJ:.o=.h) $(TESTDIR)/$(TEST_UNITYDIR)/$(TEST_UNITYINT) | $(OBJDIR)/$(TEST_OBJDIR) $(OBJDIR)/$(TEST_DEPDIR)
	@$(call show-stage,COMPILING,$<)
	@$(CC) -c $(CCFLAGS) $(TEST_INCLUDES) $(TEST_DEFINES) $< -o $@

# Create the subfolders within $(OBJDIR) for the application object files
# and dependency files.

APP_OBJDIR := appo
APP_DEPDIR := appd

$(OBJDIR)/$(APP_OBJDIR): | $(OBJDIR)
	@$(call show-stage,CREATING,$(OBJDIR)/$(APP_OBJDIR))
	@$(MKDIR) $(OBJDIR)/$(APP_OBJDIR)

$(OBJDIR)/$(APP_DEPDIR): | $(OBJDIR)
	@$(call show-stage,CREATING,$(OBJDIR)/$(APP_DEPDIR))
	@$(MKDIR) $(OBJDIR)/$(APP_DEPDIR)

# Create the $(TEST_ABSDIR) folder within $(TESTDIR)

$(TESTDIR)/$(TEST_ABSDIR):
	@$(call show-stage,CREATING,$(TESTDIR)/$(TEST_ABSDIR))
	@$(MKDIR) $(TESTDIR)/$(TEST_ABSDIR)

# Identify the dependency and object files from the $(OBJS) list.

DEPS := $(addprefix $(OBJDIR)/$(APP_DEPDIR)/, $(OBJS:.o=.d))
OBJS := $(addprefix $(OBJDIR)/$(APP_OBJDIR)/, $(OBJS))

# A rule to build the application object files from the C sources.
#
# Alongside compiling the source code, build dependecny lists for each of the
# object files and include them into the Makefile.

-include $(DEPS)

# Make up any additional object subfolder prerequisite lists.

OBJS_SUBDEPDIRS = $(addprefix $(OBJDIR)/$(APP_DEPDIR)/, $(OBJS_SUBDIRS))
OBJS_SUBOBJDIRS = $(addprefix $(OBJDIR)/$(APP_OBJDIR)/, $(OBJS_SUBDIRS))

ifneq ($(OBJS_SUBDEPDIRS),)
$(OBJS_SUBDEPDIRS): %: | $(@D)
	@$(call show-stage,CREATING,$@)
	@$(MKDIR) $@
endif

ifneq ($(OBJS_SUBOBJDIRS),)
$(OBJS_SUBOBJDIRS): %: | $(@D)
	@$(call show-stage,CREATING,$@)
	@$(MKDIR) $@
endif

$(OBJDIR)/$(APP_OBJDIR)/%.o: $(SRCDIR)/%.c $(EXTRASRCPREREQ) | $(OBJDIR)/$(APP_OBJDIR) $(OBJDIR)/$(APP_DEPDIR) $(OBJS_SUBOBJDIRS) $(OBJS_SUBDEPDIRS)
	@$(call show-stage,COMPILING,$<)
	@$(CC) -c $(CCFLAGS) -D'BUILD_VERSION="$(VERSION)"' -D'BUILD_DATE="$(BUILD_DATE)"' -D'BUILD_INFO="$(BUILDINFO)"' $(INCLUDES) $< -o $@
	@$(CC) -MM $(CCFLAGS) -D'BUILD_VERSION="$(VERSION)"' -D'BUILD_DATE="$(BUILD_DATE)"' -D'BUILD_INFO="$(BUILDINFO)"' $(INCLUDES) $< > $(OBJDIR)/$(APP_DEPDIR)/$(@F:.o=.d)
	@mv -f $(OBJDIR)/$(APP_DEPDIR)/$(@F:.o=.d) $(OBJDIR)/$(APP_DEPDIR)/$(@F:.o=.d).tmp
	@sed -e 's|.*:|$@:|' < $(OBJDIR)/$(APP_DEPDIR)/$(@F:.o=.d).tmp > $(OBJDIR)/$(APP_DEPDIR)/$(@F:.o=.d)
	@sed -e 's/.*://' -e 's/\\$$//' < $(OBJDIR)/$(APP_DEPDIR)/$(@F:.o=.d).tmp | fmt -1 | sed -e 's/^ *//' -e 's/$$/:/' >> $(OBJDIR)/$(APP_DEPDIR)/$(@F:.o=.d)
	@rm -f $(OBJDIR)/$(APP_DEPDIR)/$(@F:.o=.d).tmp

# The rule to clean the generated object and dependency files.
#
# clean-objects should be a prerequisite of the clean target.

.PHONY: clean-objects

clean-objects:
ifneq ($(OBJDIR),)
	@$(call show-stage, CLEANING, $(OBJDIR)/*)
	$(RM) $(OBJDIR)/*
endif

# The rule to clean the test absolute files.
#
# clean-tests should be a prerequisite of the clean target.

clean-tests:
ifneq ($(TESTDIR)/$(TEST_ABSDIR)/$(TEST_PREFIX)*$(TEST_ABSSUFFIX),//*)
	@$(call show-stage, CLEANING, $(TESTDIR)/$(TEST_ABSDIR)/$(TEST_PREFIX)*$(TEST_ABSSUFFIX))
	$(RM) $(TESTDIR)/$(TEST_ABSDIR)/$(TEST_PREFIX)*$(TEST_ABSSUFFIX)
endif
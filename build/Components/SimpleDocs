# Common code for documentation generation

MANUAL ?= manual
MANSRC ?= Source
README ?= ReadMe,fff
HTMLHELP ?=
TEXTENCODE ?= AcornL1

ifeq ($(OUTDIR),)
$(error Simple Documentation requires OUTDIR to be set)
endif

ifeq ($(HELP_VERSION),)
$(error Simple Documentation requires a HELP_VERSION to be set)
endif

ifeq ($(HELP_DATE),)
$(error Simple Documentation requires a HELP_DATE to be set)
endif

ifeq ($(MANTOOLS),)
$(error Simple Documentation requires MANTOOLS to be available)
endif

ifeq ($(XMLMAN),)
$(error Simple Documentation requires XMLMAN to be available)
endif

ifeq ($(RM),)
$(error Simple Documentation requires RM to be available)
endif

# In the calling Makefile, documentation should be a prerequesite of the rule
# to build all.

.PHONY: documentation

documentation: $(OUTDIR)/$(README) $(if $(HTMLHELP),$(OUTDIR)/$(HTMLHELP))

# Extract the first item from the list of manual source files, then prefix
# all of the entries with the source folder.

MANFILE := $(firstword $(MANSRC))
MANSRC := $(addprefix $(MANUAL)/, $(MANSRC))

# Build the ReadMe file in $(OUTDIR), either with XMLMan if the source filename
# ends with '.xml', or with ManTools otherwise.

$(OUTDIR)/$(README): $(MANSRC) | $(OUTDIR)
	@$(call show-stage,TEXT MANUAL,$(OUTDIR)/$(README))
ifneq ($(findstring .xml, $(MANFILE)),)
	@$(XMLMAN) $(firstword $(MANSRC)) -text $(OUTDIR)/$(README) -encoding $(TEXTENCODE) \
			-define 'version=$(HELP_VERSION)' -define 'date=$(HELP_DATE)' -define 'buildinfo=$(BUILDINFO)'
else
	@$(MANTOOLS) -MTEXT -I$(firstword $(MANSRC)) -O$(OUTDIR)/$(README) \
			-D'version=$(HELP_VERSION)' -D'date=$(HELP_DATE)'
endif

# If $(HTMLHELP) is defined, build the HTML documentation in $(OUTDIR), either
# with XMLMan if the source filename ends with '.xml', or with ManTools
# otherwise.

ifneq ($(HTMLHELP),)
$(OUTDIR)/$(HTMLHELP): $(MANSRC) | $(OUTDIR)
	@$(call show-stage,HTML MANUAL,$(OUTDIR)/$(HTMLHELP))
ifneq ($(findstring .xml, $(MANFILE)),)
	@$(XMLMAN) $(firstword $(MANSRC)) -html $(OUTDIR)/$(HTMLHELP) -encoding 7Bit \
			-define 'version=$(HELP_VERSION)' -define 'date=$(HELP_DATE)' -define 'buildinfo=$(BUILDINFO)'
else
	@$(MANTOOLS) -MHTML -C../images/ -I$(firstword $(MANSRC)) -O$(OUTDIR)/$(HTMLHELP) \
			-D'version=$(HELP_VERSION)' -D'date=$(HELP_DATE)'
endif
endif

# The rule to clean the generated documentation.
#
# clean-documentation should be a prerequisite of the clean target.

.PHONY: clean-documentation

clean-documentation:
ifneq ($(README),)
	@$(call show-stage, CLEANING, $(OUTDIR)/$(README))
	$(RM) $(OUTDIR)/$(README)
endif
ifneq ($(HTMLHELP),)
	@$(call show-stage, CLEANING, $(OUTDIR)/$(HTMLHELP))
	$(RM) $(OUTDIR)/$(HTMLHELP)
endif

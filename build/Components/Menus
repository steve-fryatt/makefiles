# Common code for Wimp menu generation

MENUGEN := $(SFTOOLS_BIN)/menugen
MENUGENFLAGS ?=

# On entry, $(MENUSRC) should be either unset, empty or the name of a file
# within $(MENUDIR) which contains the menu definitions.
#
# $(MENUS) should be the name of the generated menu data file.
#
# $(MENUFLAGS) should be set to any flags which need to be passed to MenuGen
# when it is run.
#
# The $(OUTDIR), $(APP) and $(UKRES) variables should be set between them to
# point to the appropriate UK resources folder -- usually this is done by
#
#   OUTDIR = build
#   APP = !AppDir
#   UKRES = Resources/UK
#   MENUS = Menus,ffd
#
# In the calling Makefile, $(OUTDIR)/$(APP)/$(UKRES)/$(MENUS) should be a
# prerequisite for the application target, while clean-menus should be a
# prerequisite for the clean target.

MENUS ?= Menus,ffd
MENUSRC ?= menudef
MENUDIR ?= menus
MENUFLAGS ?=

ifeq ($(OUTDIR),)
$(error Menus require OUTDIR to be set)
endif

ifeq ($(APP),)
$(error Menus require APP to be set)
endif

ifeq ($(UKRES),)
$(error Menus require UKRES to be set)
endif

# The rule to rebuild the menu definition file, looking at the source from
# $(MENUDIR)/$(MENUSRC)
#
# $(OUTDIR)/$(APP)/$(UKRES)/$(MENUS) should be a prerequisite of the application
# target.

ifneq ($(MENUS),)
$(OUTDIR)/$(APP)/$(UKRES)/$(MENUS): $(OUTDIR)/$(APP)/$(UKRES) $(MENUDIR)/$(MENUSRC)
	@$(call show-stage,MAKE MENUS,$(MENUDIR)/$(MENUSRC))
	@$(MENUGEN) $(MENUDIR)/$(MENUSRC) $(OUTDIR)/$(APP)/$(UKRES)/$(MENUS) $(MENUGENFLAGS)
endif

# The rule to clean the generated menu file.
#
# clean-menus should be a prerequisite of the clean target.

.PHONY: clean-menus

clean-menus:
ifneq ($(MENUS),)
	@$(call show-stage, CLEANING, $(OUTDIR)/$(APP)/$(UKRES)/$(MENUS))
	$(RM) $(OUTDIR)/$(APP)/$(UKRES)/$(MENUS)
endif

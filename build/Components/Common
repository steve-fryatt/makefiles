# Common Setup for Shared Makefiles
#
# This file really needs to be run by GNUMake.
# It is intended for native compilation on Linux (for use in a GCCSDK
# environment) or cross-compilation under the GCCSDK.
#
# Expectations on entry:
#
# $(VERSION) may be set to a build version number, in the form "1.23". If it is
# unset or empty, the version will be taken from the project's Git commit hash.
#
# $(ARCHIVE) should be set to a base name for any output archive files which
# may be generated: usually the name of the project, such as "myapp".
#
# $(OUTDIR) should be set to the name of the folder to take the built objects.
#
# $(PACKAGE) may be set to the name of a package file (eg. "Locate"), in which
# case packaging information will be obtained.
#
# $(GETPKGREV) should be set to the command which will be used to obtain package
# details; if not set, no package details will be configured and $(PACKAGE) will
# be unset.

ifeq ($(ARCHIVE),)
$(error Common rules require ARCHIVE to be set)
endif

ifeq ($(OUTDIR),)
$(error Common rules require OUTDIR to be set)
endif

# Set some generally useful paths to utilities.

ZIP := $(GCCSDK_INSTALL_ENV)/bin/zip
CP := cp
RM := rm -rf

# Set up escape sequences for colouring terminal output. These values are used
# by the show-stage function.

COLOUR_ACTION := \033[1;32m
COLOUR_END := \033[0m

# Provide a means of reporting progress.
#
# Call as $(call show-stage, <stage>, <filename>) where <stage> is the name of
# the build stage (eg. COMPILING, LINKING, etc) and <filename> is the name of
# the object being processed.

show-stage = $(PRINTF) "$(COLOUR_ACTION)*%18s: %s$(COLOUR_END)\n" "$(1)" "$(2)"

# Create some useful variables containing the date.
#
# $(BUILD_DATE) -> 01 Jan 2026    -- Often included in the compiled code.
# $(HELP_DATE)  -> 1 January 2026 -- Often used in the documentation.
# $(FILE_DATE)  -> 20260101       -- Often used when creating dated Zip files.

BUILD_DATE := $(shell date "+%d %b %Y")
HELP_DATE := $(shell date "+%-d %B %Y")
FILE_DATE := $(shell date "+%Y%m%d")

# Construct version or revision information.
#
# On entry:
#
# - $(VERSION) may be set externally to a version number for the build in the
#   form "1.23".
#
# - $(PACKAGE) may be set to a package name, and $(GETPKGREV) to the tool for
#   obtaining a package revision.
#
# On exit:
#
# - $(VERSION) will be set to a version string for use in the application build,
#   either as supplied (eg. "1.23") or as a Git commit hash (eg. "64f7d0b").
#
# - $(HELP_VERSION) will be set to version if user provided (eg. "1.23) or to
#   "----" if the Git commit hash is being used.
#
# - $(RELEASE) will be set to version without any dots (eg. "123" or "64f7d0b").
#
# - $(PACKAGE) may be updated with the "Unstable" prefix if appropriate, or
#   set to empty if $(GETPKGREV) was not available.
#
# - $(PKG_VERSION) will be set to the package version (eg. "1") if $(PACKAGE)
#   remains set.

ifeq ($(VERSION),)
  RELEASE := $(shell git rev-parse --short=7 HEAD)
  override VERSION := $(RELEASE)
  HELP_VERSION := ----
ifneq ($(PACKAGE),)
ifneq ($(GETPKGREV),)
  PACKAGE := $(PACKAGE)Unstable
  PKG_VERSION := $(shell $(GETPKGREV) --index unstable --package $(PACKAGE) --revision $(VERSION))
else
  PACKAGE :=
  undefine PKG_VERSION
endif
endif
else
  RELEASE := $(subst .,,$(VERSION))
  HELP_VERSION := $(VERSION)
ifneq ($(PACKAGE),)
ifneq ($(GETPKGREV),)
  PKG_VERSION := $(shell $(GETPKGREV) --index stable --package $(PACKAGE) --revision $(VERSION))
else
  PACKAGE :=
  undefine PKG_VERSION
endif
endif
endif

# Extra Info to be passed to compiler and documentation.
#
# If $(BUILDINFO) is not set by the caller, it will be set to empty. This can be
# used by Makefiles to pass on specific build information.

BUILDINFO ?=

# The archives to assemble the release files, sources and backups in.
# If $(RELEASE) is set above, then some of the files can be given a version
# number suffix.
#
# On exit:
#
# - $(ZIPFILE) will be set to a name for the release archive file.
#
# - $(SRCZIPFILE) will be set to a name for the source archive file.
#
# - $(PKGZIPFILE) will be set to a name for the package archive file.
#
# - $(BUZIPFILE) will be set to a name for the backup archive file.

ZIPFILE := $(ARCHIVE)$(RELEASE).zip
SRCZIPFILE := $(ARCHIVE)$(RELEASE)src.zip
PKGZIPFILE := $(PACKAGE)_$(PKG_VERSION).zip
BUZIPFILE := $(ARCHIVE)$(FILE_DATE).zip

# Inform the user what we're about to do.

$(info *** Building with version $(VERSION) ($(RELEASE)) on date $(BUILD_DATE) ***)

# Rules to create the object and output folders.
#
# $(OBJDIR) and $(OUTDIR) should be prerequisites of all appropriate rules in
# the calling files.

ifneq ($(OBJDIR),)
$(OBJDIR):
	@$(call show-stage,CREATING,$(OBJDIR))
	@$(MKDIR) $(OBJDIR)
endif

$(OUTDIR):
	@$(call show-stage,CREATING,$(OUTDIR))
	@$(MKDIR) $(OUTDIR)

# Rules to create the App and UK Resources folders.
#
# $(OUTDIR)/$(APP) and $(OUTDIR)/$(APP)/$(UKRES) should be prerequisites of all
# appropriate rules in the calling files.

ifneq ($(APP),)
$(OUTDIR)/$(APP): $(OUTDIR)
	@$(call show-stage,CREATING,$(OUTDIR)/$(APP))
	@$(MKDIR) $(OUTDIR)/$(APP)

ifneq ($(UKRES),)
$(OUTDIR)/$(APP)/$(UKRES): $(OUTDIR)/$(APP)
	@$(call show-stage,CREATING,$(OUTDIR)/$(APP)/$(UKRES))
	@$(MKDIR) $(OUTDIR)/$(APP)/$(UKRES)
endif
endif

# A rule to build the 'backup' target, which takes all of the files within the
# project and writes them to a dated Zip archive in the project's parent folder.
#
# As standard, the .git and .svn folders are not included in the archive.

BUZIPFLAGS ?= -x "*/.svn/*" "*/.git/*" -r -9

.PHONY: backup

backup:
ifneq ($(BUZIPFILE),)
	@$(call show-stage,ZIPPING BACKUP,$(BUZIPFILE))
	@$(RM) ../$(BUZIPFILE)
	@$(ZIP) $(BUZIPFLAGS) ../$(BUZIPFILE) *
endif

# Rules to handle copying and cleaning the licence.
#
# The caller can set $(LICENCE) and $(LICSRC) if they wish, or standard defaults
# will be used.

.PHONY: licence clean-licence

LICENCE ?= Licence,fff
LICSRC ?= Licence

# The rule to copy the licence over from $(LICSRC) in the root of the project
# to $(OUTDIR)/$(LICENCE).
#
# licence should be a prerequisite of the all target.

licence: $(OUTDIR)/$(LICENCE)

$(OUTDIR)/$(LICENCE): $(LICSRC)
	@$(call show-stage,LICENCE,$(OUTDIR)/$(LICENCE))
	@$(CP) $(LICSRC) $(OUTDIR)/$(LICENCE)

# The rule to clean the copied licence file
#
# clean-licence should be a prerequisite of the clean target.

clean-licence:
	@$(call show-stage, CLEANING, $(OUTDIR)/$(LICENCE))
	$(RM) $(OUTDIR)/$(LICENCE)
